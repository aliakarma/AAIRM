# AAIRM Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── LLM API Keys (required for C4 LLM negotiation mode) ─────────────────
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...   # optional alternative backbone

# ── LangSmith (optional — enables agent execution tracing) ──────────────
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls__...
# LANGCHAIN_PROJECT=aairm

# ── Kaggle (required for make download-data) ─────────────────────────────
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# ── Experiment Settings ──────────────────────────────────────────────────
AAIRM_LOG_LEVEL=INFO
AAIRM_LOG_FORMAT=console
AAIRM_SEED=42
AAIRM_RESULTS_DIR=experiments/results
