{
  "description": "Demand generation parameters for the AAIRM synthetic simulation. See DemandGenerator in aairm/simulation/demand_generator.py.",
  "paper_reference": "Syed et al. (2025), Section 5.1",
  "seed": 42,
  "category_seasonality_amplitude": {
    "grocery": 0.15,
    "frozen_food": 0.25,
    "apparel": 0.4,
    "cosmetics": 0.2,
    "dry_fruits": 0.3
  },
  "base_demand_range": {
    "min": 20.0,
    "max": 200.0,
    "distribution": "Uniform"
  },
  "demand_noise": {
    "distribution": "LogNormal",
    "mu": 0.0,
    "sigma_range": {
      "min": 0.05,
      "max": 0.25
