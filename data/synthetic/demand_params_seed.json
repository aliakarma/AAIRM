      "name": "Eid_Al_Fitr",
      "uplift": 2.0,
      "duration_days": 3
    },
    {
      "name": "Eid_Al_Adha",
      "uplift": 1.8,
      "duration_days": 3
    },
    {
      "name": "Ramadan",
      "uplift": 1.3,
      "duration_days": 30
    },
    {
      "name": "National_Day",
      "uplift": 1.4,
      "duration_days": 2
    },
    {
      "name": "New_Year",
      "uplift": 1.2,
      "duration_days": 1
    }
  ],
  "lead_time_delay_probability": 0.15,
  "partial_fulfillment_probability": 0.05,
  "partial_fulfillment_range": {
    "min": 0.5,
    "max": 0.9
